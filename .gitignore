# ==============================================================================
# MERN STACK GLOBAL GITIGNORE TEMPLATE
# ==============================================================================

# --- Package Dependencies ---
# Ignores large dependency trees in both root, frontend, and backend folders
node_modules/
jspm_packages/
web_modules/

# --- Environment Variables & Secrets ---
# CRITICAL: Never commit database credentials, API keys, or JWT tokens
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# --- Production Build Outputs ---
# Excludes the production build folder generated by React/Vite/Next.js
build/
dist/
out/
.next/

# --- Server Logs & System Files ---
# Logs generated by Node, npm errors, or process managers (PM2)
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Diagnostic & Coverage Tools ---
# Excludes test coverage outputs and profiling snapshots
coverage/
.nyc_output/
*.cpuprofile
*.heapprofile
*.memprofile

# --- Editor / IDE Specific Files ---
# Keeps individual developer workstation preferences out of the codebase
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Operating System Files ---
# Trash files automatically generated by Windows or MacOS
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
